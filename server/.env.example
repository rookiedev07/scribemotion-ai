PORT=5000
NODE_ENV=development

# Transcription Provider:
#   local   - Uses local Whisper AI model via Python (default, no API key needed, transcribes actual video audio)
#   openai  - Uses OpenAI Whisper API (requires OPENAI_API_KEY below)
TRANSCRIPTION_PROVIDER=local

# Only required if TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=

UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
